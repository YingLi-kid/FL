if(PROJECT_NAME STREQUAL "AudioCpp")
    set(FL_AUDIOCPP_BRIDGE "${CMAKE_CURRENT_LIST_DIR}/audiocpp_bridge.cpp")
    function(fl_add_audiocpp_bridge)
        add_library(fl_audiocpp_jni SHARED "${FL_AUDIOCPP_BRIDGE}")
        target_compile_features(fl_audiocpp_jni PRIVATE cxx_std_17)
        target_compile_options(fl_audiocpp_jni PRIVATE -fvisibility=hidden)
        target_link_libraries(fl_audiocpp_jni PRIVATE audiocpp_static log)
        target_link_options(fl_audiocpp_jni PRIVATE "-Wl,--exclude-libs,ALL" "-Wl,--no-undefined")
    endfunction()
    cmake_language(DEFER CALL fl_add_audiocpp_bridge)
endif()
